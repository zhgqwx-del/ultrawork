+      url: r.link,
+      // `summary` is a paid value-added field we don't request; `snippet` is free.
+      snippet: typeof r.snippet === "string" ? r.snippet : undefined,
+      score: typeof r.rerankScore === "number" ? r.rerankScore : undefined,
+      publishedTime: typeof r.publishedTime === "string" ? r.publishedTime : undefined,
