diff --git a/packages/opencode/src/effect/soft-invalidate-registry.ts b/packages/opencode/src/effect/soft-invalidate-registry.ts
new file mode 100644
index 000000000..f66dc0a85
--- /dev/null
+++ b/packages/opencode/src/effect/soft-invalidate-registry.ts
@@ -0,0 +1,30 @@
+// Soft-invalidation registry — a parallel set to instance-registry's disposers.
+//
+// A "soft refresh" re-reads config-derived caches (config / provider / skills /
+// agents / commands / formatters / tool-registry) WITHOUT tearing down the whole
+// instance. Only InstanceStates created via `InstanceState.makeSoft` register
+// here; live-resource states (session prompt runners, MCP clients, LSP servers,
+// PTYs, file watchers, Bus PubSubs, permission/question deferreds) do NOT — so an
+// in-flight streaming turn survives a soft refresh completely untouched.
+//
+// Driven by `Config.refreshGlobal` (HTTP: `PATCH /global/config?refresh=soft` and
+// `POST /global/refresh`) to make a global config / skill change live immediately
+// without aborting any active work. See Ultrawork ADR-039.
+
+const soft = new Set<(directory: string) => Promise<void>>()
+
+export function registerSoftInvalidator(invalidator: (directory: string) => Promise<void>) {
+  soft.add(invalidator)
+  return () => {
+    soft.delete(invalidator)
+  }
+}
+
+// Evict the soft-registered caches for one directory. Invalidation is lazy
+// eviction (the ScopedCache rebuilds on next access in dependency order), so the
+// registration order of invalidators does not affect correctness. Returns the
+// settled results so the caller can surface failures (a swallowed eviction failure
+// would otherwise leave a stale cache with no signal).
+export async function softInvalidate(directory: string): Promise<PromiseSettledResult<void>[]> {
+  return Promise.allSettled([...soft].map((invalidator) => invalidator(directory)))
+}
