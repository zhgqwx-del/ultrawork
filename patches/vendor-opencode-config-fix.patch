+      score: typeof r.score === "number" ? r.score : undefined,
+      publishedTime: typeof r.published_date === "string" ? r.published_date : undefined,
+    })
+  }
+  return { items, answer: typeof data?.answer === "string" && data.answer ? data.answer : undefined }
