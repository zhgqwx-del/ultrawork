+export function formatSearchOutput(
+  query: string,
+  provider: WebsearchProviderId,
+  items: SearchResultItem[],
+  answer?: string,
+): string {
+  if (items.length === 0 && !answer) {
+    return `No search results found for "${query}" (provider: ${provider}). Try a different or broader query.`
+  }
+  const lines: string[] = [`Web search results for "${query}" (provider: ${provider})`]
+  if (answer) lines.push("", `Answer: ${answer}`)
+  items.forEach((item, i) => {
+    lines.push("", `${i + 1}. ${item.title}`, `   URL: ${item.url}`)
+    const meta: string[] = []
+    if (item.publishedTime) meta.push(`published: ${item.publishedTime}`)
+    if (typeof item.score === "number") meta.push(`score: ${item.score.toFixed(3)}`)
+    if (meta.length) lines.push(`   (${meta.join(", ")})`)
+    if (item.snippet) lines.push(`   ${item.snippet.replace(/\s*\n\s*/g, " ").trim()}`)
+  })
