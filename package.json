{
  "name": "ultrawork",
  "version": "0.3.6",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.12",
  "workspaces": [
    "packages/core/*",
    "packages/agent/*",
    "packages/client/*",
    "packages/channel/*",
    "packages/knowledge/*",
    "packages/proactive/*"
  ],
  "scripts": {
    "setup": "bun run scripts/setup.ts",
    "dev": "turbo run dev",
    "dev:desktop": "turbo run dev --filter=@agent/client-desktop",
    "tauri:dev": "cd packages/client/desktop && bun run --bun tauri dev",
    "tauri:build": "cd packages/client/desktop && bun run --bun tauri build",
    "build": "turbo run build",
    "build:opencode": "bun run scripts/build-opencode.ts",
    "build:gateway": "bun run scripts/build-gateway.ts",
    "build:knowledge": "bun run scripts/build-knowledge.ts",
    "build:acp": "bun run scripts/build-acp.ts",
    "sync:plugin-version": "bun run scripts/sync-plugin-version.ts",
    "gen:notices": "bun run scripts/gen-notices.ts",
    "check:docs": "bun run scripts/check-docs.ts",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"packages/**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"packages/**/*.{ts,tsx,json,md}\"",
    "release": "bun run scripts/build-release.ts"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.19.19",
    "@types/opencc-js": "^1.0.3",
    "fflate": "^0.8.3",
    "opencc-js": "^1.4.1",
    "playwright-core": "^1.61.1",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "turbo": "^2.9.14",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "unpdf": "^1.6.2"
  }
}
