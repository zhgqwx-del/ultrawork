+export function parseIqsResponse(json: unknown): { items: SearchResultItem[] } {
+  const data = json as { pageItems?: unknown }
+  const pageItems = Array.isArray(data?.pageItems) ? data.pageItems : []
+  const items: SearchResultItem[] = []
+  for (const raw of pageItems) {
+    const r = raw as Record<string, unknown>
+    if (typeof r?.link !== "string") continue
+    items.push({
