+export function resolveSearchProviders(
+  settings: WebsearchSettings | undefined,
+  hasKey: { tavily: boolean; "aliyun-iqs": boolean },
+  opts?: { implicitExa?: boolean },
+): WebsearchProviderId[] {
+  if (settings?.enabled === false) return []
+  const available: WebsearchProviderId[] = []
+  if (hasKey.tavily) available.push("tavily")
+  if (hasKey["aliyun-iqs"]) available.push("aliyun-iqs")
+  if (settings?.exa === true || settings?.provider === "exa" || opts?.implicitExa === true) available.push("exa")
+  const explicit = settings?.provider
+  if (explicit && explicit !== "auto" && available.includes(explicit))
+    return [explicit, ...available.filter((p) => p !== explicit)]
