{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ultrawork",
  "version": "0.2.4",
  "identifier": "com.ultrawork.desktop",
  "build": {
    "beforeDevCommand": "bun run --bun ../../../scripts/pack-builtin-skills.ts && bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run --bun ../../../scripts/pack-builtin-skills.ts && bun run --bun turbo run build --filter=@agent/client-desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ultrawork",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/opencode-server",
      "binaries/channel-gateway",
      "binaries/knowledge-sidecar",
      "binaries/acp-client"
    ],
    "resources": {
      "resources/builtin-skills": "skills/builtin"
    },
    "linux": {
      "deb": {
        "depends": ["curl", "lsof"]
      },
      "rpm": {
        "depends": ["curl", "tar", "lsof"]
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": "entitlements.plist"
    }
  }
}
